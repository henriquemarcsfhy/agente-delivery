# Qualquer endpoint compatível com a API de Chat Completions da OpenAI.

# OpenAI
LLM_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini

# Ollama (local, grátis): deixe LLM_API_KEY vazio
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:7b

# Groq (plano gratuito, sem cartão): console.groq.com/keys
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk_...
# LLM_MODEL=<um modelo com suporte a tool use, veja console.groq.com/docs/models>

# Google Gemini (plano gratuito): aistudio.google.com/apikey
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_API_KEY=...
# LLM_MODEL=<um modelo gemini-*-flash atual>
